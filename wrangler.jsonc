{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "typist-mcp-dev",
  "main": "./src/index.ts",
  "compatibility_date": "2026-05-22",
  "compatibility_flags": ["nodejs_compat"],
  "upload_source_maps": true,
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "head_sampling_rate": 1,
    },
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["TypistMcp"],
    },
  ],
  "durable_objects": {
    "bindings": [
      { "name": "MCP_OBJECT", "class_name": "TypistMcp" },
      { "name": "RATE_LIMITER", "class_name": "RateLimiterDO", "script_name": "typist-dev" },
    ],
  },
  // Local dev: main app must be running (`pnpm dev`) so the service binding resolves.
  "vars": {
    "ENV": "development",
    "MAIN_APP_URL": "http://localhost:5174",
  },
  // OAUTH_KV reuses the main app's TYPIST_AUTH namespace (auth state lives
  // together); workers-oauth-provider keys are prefixed and cannot collide.
  "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "d10d6cf49ace4aea869b2656a8a98620" }],
  "services": [
    { "binding": "TYPIST_GATEWAY", "service": "typist-dev", "entrypoint": "McpGateway" },
  ],
  "secrets": {
    "required": ["MCP_STATE_SECRET"],
  },
  "env": {
    // Test: no cross-script bindings — vitest supplies a fake gateway worker
    // (TYPIST_GATEWAY service binding + RATE_LIMITER DO) via miniflare options.
    "test": {
      "name": "typist-mcp-test",
      "vars": {
        "ENV": "development",
        "MAIN_APP_URL": "https://app.test",
      },
      "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "test-oauth-kv" }],
      "durable_objects": {
        "bindings": [{ "name": "MCP_OBJECT", "class_name": "TypistMcp" }],
      },
    },
    "prod": {
      "name": "typist-mcp",
      "vars": {
        "ENV": "production",
        "MAIN_APP_URL": "https://iamtypist.dev",
      },
      "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "a76e629b08df4062b629d2bc8ba59215" }],
      "services": [
        { "binding": "TYPIST_GATEWAY", "service": "typist", "entrypoint": "McpGateway" },
      ],
      "durable_objects": {
        "bindings": [
          { "name": "MCP_OBJECT", "class_name": "TypistMcp" },
          { "name": "RATE_LIMITER", "class_name": "RateLimiterDO", "script_name": "typist" },
        ],
      },
      "secrets": {
        "required": ["MCP_STATE_SECRET"],
      },
      "routes": [
        {
          "pattern": "mcp.iamtypist.dev",
          "custom_domain": true,
        },
      ],
    },
  },
}
