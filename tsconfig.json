{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "target": "esnext",
    "lib": [
      "ESNext"
    ],
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": [
      "@cloudflare/vitest-plugin/types"
    ],
    "paths": {},
    "allowImportingTsExtensions": false,
    "noEmit": true,
    "composite": false,
    "incremental": true
  },
  "include": [
    "src",
    "tests/**/*.ts",
    "vitest.config.ts",
    "worker-configuration.d.ts"
  ]
}
